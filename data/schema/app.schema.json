{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EMMA app settings",
  "description": "data/yaml/app.yaml",
  "type": "object",
  "required": ["name", "full_name", "ios"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string"},
    "full_name": {"type": "string"},
    "ios": {
      "type": "object",
      "required": ["bundle_id"],
      "additionalProperties": false,
      "properties": {
        "bundle_id": {"type": "string", "pattern": "^[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+$"}
      }
    }
  }
}
