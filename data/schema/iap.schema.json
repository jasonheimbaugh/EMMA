{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Incident Action Plan",
  "description": "An Incident Action Plan: data/yaml/template/iap.yaml and each incident's iap.yaml.",
  "type": "object",
  "required": ["incident", "operational_period", "prepared_by", "approved_by", "forms"],
  "additionalProperties": false,
  "$defs": {
    "person": {
      "type": "object",
      "required": ["name", "position"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "position": {"type": "string"}
      }
    },
    "dateTime": {
      "type": "string",
      "pattern": "^$|^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}$"
    }
  },
  "properties": {
    "incident": {
      "type": "object",
      "required": ["name", "number"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "number": {"type": "string", "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}-\\d{4}$"}
      }
    },
    "operational_period": {
      "type": "object",
      "required": ["number", "start", "end"],
      "additionalProperties": false,
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "start": {"$ref": "#/$defs/dateTime"},
        "end": {"$ref": "#/$defs/dateTime"}
      }
    },
    "prepared_by": {"$ref": "#/$defs/person"},
    "approved_by": {"$ref": "#/$defs/person"},
    "forms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["form", "title", "file", "include"],
        "additionalProperties": false,
        "properties": {
          "form": {"type": "string", "pattern": "^ICS \\d{3}[A-Z]?$"},
          "title": {"type": "string"},
          "file": {"type": "string", "pattern": "^ics-\\d{3}[a-z]?\\.md$"},
          "prepared_by": {"type": "string"},
          "include": {"type": "boolean"}
        }
      }
    }
  }
}
